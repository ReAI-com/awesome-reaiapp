{
  "name": "reai-ai-employee-demo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "reaiApp": {
    "entry": "src/app.ts"
  },
  "scripts": {
    "dev:showcase": "vite --config vite.showcase.config.ts",
    "build:showcase": "vite build --config vite.showcase.config.ts",
    "dev": "bun scripts/sync-release-notes.ts && vite --host 127.0.0.1 --port 4189 --strictPort",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/sync-release-notes.ts && reai-app build .",
    "validate": "reai-app validate .",
    "test:contract": "reai-app contract-test . --host-api 1.24",
    "pack": "bun scripts/sync-release-notes.ts && reai-app pack . --out ai-employee-0.2.0.reaiapp",
    "scaffold": "bun scripts/scaffold.ts",
    "prepare:agent": "bun scripts/prepare-agent.ts",
    "sync:notes": "bun scripts/sync-release-notes.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@reai/app-cli": "file:../../vendor/platform/4ed2325a750e/packs/app-cli.tgz",
    "@reai/app-contract": "file:../../vendor/platform/4ed2325a750e/packs/app-contract.tgz",
    "@reai/app-sdk": "file:../../vendor/platform/4ed2325a750e/packs/app-sdk.tgz",
    "@reai/app-test": "file:../../vendor/platform/4ed2325a750e/packs/app-test.tgz",
    "@types/bun": "^1.3.14",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "@reai/app-cli": "file:../../vendor/platform/4ed2325a750e/packs/app-cli.tgz",
    "@reai/app-contract": "file:../../vendor/platform/4ed2325a750e/packs/app-contract.tgz",
    "@reai/app-sdk": "file:../../vendor/platform/4ed2325a750e/packs/app-sdk.tgz",
    "@reai/app-test": "file:../../vendor/platform/4ed2325a750e/packs/app-test.tgz"
  }
}
