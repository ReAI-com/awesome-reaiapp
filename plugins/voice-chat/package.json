{
  "name": "reai-voice-chat-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "reaiApp": {
    "entry": "src/app.ts"
  },
  "scripts": {
    "sync:notes": "bun scripts/sync-release-notes.ts",
    "test": "bun scripts/sync-release-notes.ts && bun test --pass-with-no-tests tests",
    "typecheck": "bun scripts/sync-release-notes.ts && tsc --noEmit",
    "build": "bun scripts/sync-release-notes.ts && reai-app-i18n build .",
    "validate": "reai-app-i18n validate .",
    "test:contract": "bun scripts/sync-release-notes.ts && reai-app contract-test . --host-api 1.25",
    "pack": "bun scripts/sync-release-notes.ts && reai-app-i18n pack . --out voice-chat-0.1.0.reaiapp",
    "check:submission": "reai-app-i18n submission check .",
    "pack:submission": "bun scripts/sync-release-notes.ts && reai-app-i18n submission pack . --out voice-chat-0.1.0-submission.reaiapp"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.8.4",
    "@reai/app-cli": "file:../../vendor/platform/a70c2dd93b73/packs/app-cli.tgz",
    "@reai/app-contract": "file:../../vendor/platform/a70c2dd93b73/packs/app-contract.tgz",
    "@reai/app-i18n-cli": "file:../../vendor/platform/a70c2dd93b73/packs/app-i18n-cli.tgz",
    "@reai/app-sdk": "file:../../vendor/platform/a70c2dd93b73/packs/app-sdk.tgz",
    "@reai/app-test": "file:../../vendor/platform/a70c2dd93b73/packs/app-test.tgz",
    "@types/bun": "^1.3.14",
    "typescript": "~5.6.0"
  },
  "overrides": {
    "@reai/app-cli": "file:../../vendor/platform/a70c2dd93b73/packs/app-cli.tgz",
    "@reai/app-contract": "file:../../vendor/platform/a70c2dd93b73/packs/app-contract.tgz",
    "@reai/app-i18n-cli": "file:../../vendor/platform/a70c2dd93b73/packs/app-i18n-cli.tgz",
    "@reai/app-sdk": "file:../../vendor/platform/a70c2dd93b73/packs/app-sdk.tgz",
    "@reai/app-test": "file:../../vendor/platform/a70c2dd93b73/packs/app-test.tgz"
  }
}
