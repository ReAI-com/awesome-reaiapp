{
  "name": "reai-computer-app",
  "version": "0.1.1-dev.1",
  "private": true,
  "type": "module",
  "reaiApp": {
    "entry": "src/app.ts"
  },
  "scripts": {
    "test": "bun test --pass-with-no-tests tests",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/sync-release-notes.ts && reai-app build .",
    "validate": "reai-app validate .",
    "test:contract": "reai-app contract-test . --host-api 1.5",
    "pack": "bun scripts/sync-release-notes.ts && reai-app pack . --out computer-0.1.1-dev.1.reaiapp",
    "sync:notes": "bun scripts/sync-release-notes.ts"
  },
  "devDependencies": {
    "@reai/app-cli": "file:../../packages/cli",
    "@reai/app-contract": "file:../../packages/contract",
    "@reai/app-sdk": "file:../../packages/sdk",
    "@reai/app-test": "file:../../packages/test-kit",
    "@types/bun": "^1.3.14",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "@reai/app-cli": "file:../../packages/cli",
    "@reai/app-contract": "file:../../packages/contract",
    "@reai/app-sdk": "file:../../packages/sdk",
    "@reai/app-test": "file:../../packages/test-kit"
  }
}
