{
  "name": "reai-voice-app",
  "version": "2.14.7",
  "private": true,
  "type": "module",
  "reaiApp": {
    "entry": "src/app.ts"
  },
  "scripts": {
    "test": "bun run prepare:documents && bun test --pass-with-no-tests tests packages/chat-ui/tests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/chat-ui",
    "build": "bun run prepare:documents && reai-app-i18n build .",
    "validate": "reai-app-i18n validate .",
    "test:contract": "reai-app contract-test . --host-api 1.25",
    "pack": "bun run prepare:documents && reai-app-i18n pack . --out voice-2.14.7.reaiapp",
    "check:submission": "bun ../../scripts/plugin-submission.ts check .",
    "pack:submission": "bun run prepare:documents && bun ../../scripts/plugin-submission.ts pack . --out voice-2.14.7-submission.reaiapp",
    "manifest:agent-features": "bun scripts/sync-agent-features.ts",
    "prepare:documents": "bun scripts/prepare-document-assets.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "fflate": "0.8.3",
    "markdown-it": "15.0.2",
    "pdfjs-dist": "6.3.289",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@reai/app-cli": "file:../../packages/cli",
    "@reai/app-contract": "file:../../packages/contract",
    "@reai/app-i18n-cli": "file:../../packages/i18n-cli",
    "@reai/app-sdk": "file:../../packages/sdk",
    "@reai/app-test": "file:../../packages/test-kit",
    "@reai/chat-ui": "file:./packages/chat-ui",
    "@types/bun": "^1.3.14",
    "typescript": "~5.6.0"
  },
  "overrides": {
    "@reai/app-cli": "file:../../packages/cli",
    "@reai/app-contract": "file:../../packages/contract",
    "@reai/app-sdk": "file:../../packages/sdk",
    "@reai/app-test": "file:../../packages/test-kit"
  }
}
