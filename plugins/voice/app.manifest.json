{
  "manifestVersion": "1.1",
  "appId": "com.reai.voice",
  "version": "2.14.7",
  "publisherId": "4d8a4ddb-2293-4b11-9ef4-3f24f117998c",
  "name": "语音输入法",
  "description": "按下语音键开始录音，再按一次完成识别并把文字写入当前应用",
  "icon": "assets/icon.png",
  "storeListing": {
    "category": "Official",
    "tagline": "按一下语音键开始说话，再按一下让文字落进当前应用",
    "longDescription": "按下语音键开始录音，再按一次完成本地语音识别并把文字写进当前应用。Host 默认保留当前运行期最多一小时的私有循环缓存，用于补回按键前的发言开头。开启全天存档后，键盘听到的话会按天收进 Context 档并自动生成当日总结；记录留在本机，到期自己过期，只有单条可以在详情页删除。",
    "capabilities": [
      {
        "label": "侧栏会多一项",
        "detail": "语音输入法"
      },
      {
        "label": "需要的权限",
        "detail": "Board USB HID 不需要麦克风；显式系统输入才需要麦克风 · 辅助功能（把文字写进别的应用）"
      },
      {
        "label": "占用硬件",
        "detail": "语音键"
      }
    ],
    "screenshots": [
      {
        "gradient": "linear-gradient(135deg,#5c5ce0,#8a7bf0)",
        "caption": "录音胶囊：按一下开始，再按一下完成并落字",
        "hasVideo": true
      },
      {
        "gradient": "linear-gradient(135deg,#4a4ac8,#6b6bd8)",
        "caption": "Voice 页：语音输入历史与详情"
      },
      {
        "gradient": "linear-gradient(135deg,#7b6bd0,#a08ae0)",
        "caption": "插件设置：音频来源与本地模型"
      }
    ]
  },
  "targets": [
    {
      "platform": "macos",
      "architectures": [
        "aarch64",
        "x86_64"
      ]
    },
    {
      "platform": "windows",
      "architectures": [
        "aarch64",
        "x86_64"
      ]
    }
  ],
  "hostApi": {
    "range": ">=1.25.0 <2.0.0"
  },
  "requires": {
    "hostCapabilities": [
      "surface.main@1",
      "surface.navigation@1",
      "sidebar.item@1",
      "storage.kv@1",
      "commands@1",
      "apps.service@1",
      "voice.input@1",
      "voice.command@1",
      "voice.deliver@1",
      "voice.context@1",
      "voice.recordings@1",
      "activation.startup@1",
      "system.tasks@1",
      "titlebar.action@1",
      "cloud.model.invoke@1",
      "agent.session@1",
      "metadata.i18n@1",
      "surface.clipboard@1",
      "agent.session@2",
      "system.folder-pick@1",
      "local.terminal.exec@1",
      "audio.capture@1",
      "audio.clips@1",
      "surface.escape@1"
    ],
    "hardwareServices": [],
    "appIntents": [
      {
        "appId": "com.reai.agents-im",
        "intent": "attach-context",
        "version": "1.0.0",
        "required": false,
        "purpose": "Context 段详情页头「发给 agent」：把这一段作为附件带进 Agents·IM 的会话输入（A3-24）",
        "requiredFor": []
      }
    ]
  },
  "runtime": {
    "components": [
      {
        "id": "ui",
        "kind": "web-surface",
        "protocol": "web-surface@1",
        "required": true,
        "headless": false,
        "activation": "startup",
        "entry": "dist/app.js",
        "dependsOn": [],
        "lifecycle": {
          "activate": "default.activate",
          "deactivate": "default.deactivate"
        }
      }
    ]
  },
  "permissions": [
    {
      "id": "account.status@1",
      "purpose": "只读取当前是否已登录，用于显示 Voice 的云端功能和 Agent 可用状态；不读取账号、令牌或订阅详情",
      "required": false
    },
    {
      "id": "cloud.model.invoke@1",
      "purpose": "选择云端识别或使用语音 Agent 时，用你的账户额度调用 Wainao 模型（会产生用量）",
      "required": false
    },
    {
      "id": "voice.deliver@1",
      "purpose": "把整理好的文字写入此刻光标所在的输入框（语音输入、转文本与翻译都走它）",
      "required": false
    },
    {
      "id": "voice.context@1",
      "purpose": "开启「润色上下文」后，读取当前输入框里的文字帮 AI 对齐称谓与语气（不读窗口标题和文件路径）",
      "required": false
    },
    {
      "id": "agent.session@1",
      "purpose": "让 Voice 通过通用 Agent 服务使用你选择的 Pi、DSH 或 Codex，并使用你的账户额度处理命令与润色",
      "required": false
    },
    {
      "id": "agent.session@2",
      "purpose": "通过统一 Agent 服务使用 Pi、DSH 或 Codex 处理语音任务，保留请求与结果并支持准确取消",
      "required": false
    },
    {
      "id": "local.terminal.exec@1",
      "purpose": "让 Agent 在你授权的工作目录内运行命令（系统层限定只能读写该目录）；范围外路径逐次确认，不开放任意位置的 shell",
      "required": false
    },
    {
      "id": "audio.capture@1",
      "purpose": "订阅 Host 的共享收音，让语音输入能补上按下语音键之前的话",
      "required": false
    },
    {
      "id": "audio.clips@1",
      "purpose": "按下到松开（含松开后约 1.5 秒）截取一段共享录音在本机转成文字；片段只在本次识别期间持有，用完即释放",
      "required": false
    }
  ],
