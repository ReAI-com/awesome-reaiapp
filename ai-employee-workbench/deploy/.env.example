# Copy to deploy/.env and restrict it to the deployment operator (chmod 600).
# Replace these with the registered OAuth public client and verified user IDs.
WAINAO_OAUTH_CLIENT_ID=
WAINAO_ADMIN_SUBJECTS=
WAINAO_ALLOWED_SUBJECTS=
WAINAO_ALLOW_SITE_ADMINS=false
# Keep false after OAuth app publication. A registered development app may use
# true only for allowlisted developers' HTTPS authorization/acceptance tests.
WAINAO_OAUTH_DEVELOPMENT=false

# The application uses the official Wainao API by default.
# Runtime origin/host/port/data path are fixed in compose.yaml.
# Use a release-specific image tag for rollback.
MAODING_RELEASE=local
# Optional: an approved Node >=22.19 image tag or digest, available on the host.
MAODING_NODE_IMAGE=node:22
