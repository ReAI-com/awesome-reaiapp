      "implementation": "host-broker-bridge-sdk-and-history-wired; grant-gated-by-capability-review-user-consent-and-scene-decision"
    },
    "resources.files@1": {
      "version": 1,
      "available": true,
      "methods": [
        "resources.roots.list",
        "resources.roots.pick",
        "resources.roots.attach",
        "resources.roots.revoke",
        "resources.list",
        "resources.stat",
        "resources.read",
        "resources.write.start",
        "resources.write.chunk",
        "resources.write.commit",
        "resources.cancel",
        "resources.mkdir",
        "resources.rename",
        "resources.move",
        "resources.delete",
        "resources.createFile"
      ],
      "userPermission": "resources.files@1",
      "admission": "manifest + platform-approval + user-consent (where required) + live-host-scope"
    }
