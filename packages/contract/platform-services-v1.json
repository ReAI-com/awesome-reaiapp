        "audio.clips.transcriptionStatus"
      ],
      "userPermission": "audio.clips@1",
      "admission": "manifest + platform-approval + user-consent (where required) + live-host-scope",
      "implementation": "host-clip-scheduler-sdk-and-bridge-wired; grant-gated-by-capability-review-and-user-consent-with-audio.capture@1"
    },
    "tasks.present@1": {
      "version": 1,
      "available": true,
      "methods": [
        "tasks.present",
        "tasks.progress",
        "tasks.finish",
        "tasks.dismiss",
        "tasks.conversationOpened",
        "results.present",
        "results.continue",
        "results.dismiss"
      ],
      "userPermission": "tasks.present@1",
      "admission": "manifest + platform-approval + user-consent (where required) + live-host-scope",
      "implementation": "owned-task-source-barriers-producer-drainer-neutral-result-fifo-wired; grant-gated-by-capability-review-and-user-consent"
    },
