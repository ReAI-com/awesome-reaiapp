    "actionItems": {
      "supported": true,
      "$note": "C-3b：声明「可把运行时条目挂进 Action 层」。门在 manifest.rs 结构体 + check_references；manifest 里的 Command 不需要这条声明，Host 只存挂载状态"
    },
    "eventSubscriptions": {
      "supported": true,
      "events": [
        "actionContext"
      ],
      "$note": "门在 manifest.rs + validator；事件类型清单是合同（v1 仅 actionContext），Rust 与 CLI 从本文件读"
    },
    "acceptsActionContext": {
      "supported": true,
      "contextTypes": [
        "recording"
      ],
      "$note": "C1-5：声明接受哪类 Action 上下文；contextTypes 清单是合同（v1 仅 recording），Rust 与 CLI 从本文件读"
    },
    "agentFeatures": {
      "supported": true,
      "maxCountPerApp": 16,
      "maxIdLength": 64,
      "maxNameLength": 48,
      "maxDescriptionLength": 200,
      "allowedRuntimes": [
        "pi",
        "dsh",
        "codex"
      ],
      "maxPromptTemplateLength": 16384,
      "maxPromptParamsPerFeature": 16,
      "maxParamNameLength": 64,
      "maxParamDescriptionLength": 200,
      "maxToolBasePerFeature": 32,
      "minHostApi": "1.23.0",
      "$note": "C-AC：声明插件内 Agent 功能的默认值与可调范围（方案 B：promptTemplate 带 {slot}，槽位必须在 promptParams 登记；toolBase 是用户可勾选的基集上限，勾选不等于授权）。门在 manifest.rs + validator；声明时必须同时声明 agent.session@2 且 hostApi.range 下界 ≥ minHostApi（旧 Host 因未知字段整包拒装）。长度口径：id/参数名/模板按 UTF-8 字节，name/description 按字符数"
    },
    "notificationScenes": {
      "supported": true,
      "minHostApi": "1.25.0"
    }
  },
