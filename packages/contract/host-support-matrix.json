{
  "$comment": "Host 能力支持矩阵 —— validator 与文档的单一事实源。任何合法但未实现的非空字段一律返回稳定错误码，不静默忽略。",
  "matrixVersion": 1,
  "hostApi": "1.25.0",
  "environment": {
    "uiLocale": {
      "since": "1.16.0",
      "locales": [
        "zh",
        "en"
      ],
      "bridgeMethods": [
        "locale.get"
      ],
      "events": [
        "locale.changed"
      ],
      "requiredPermission": null
    },
    "developerMode": {
      "since": "1.20.0",
      "bridgeMethods": [
        "environment.get"
      ],
      "requiredPermission": null
    }
  },
  "profile": "official-only",
  "profileNote": "official-only 只约束生产 Catalog：普通用户只安装官方签名插件。本机 Developer Mode 仍可导入未经审核的第三方 .reaiapp；它们可使用 granted 能力，但继续受 Manifest、Bridge、权限、资源和平台门禁约束。",
  "platform": {
    "supported": [
      "macos",
      "windows"
    ],
    "minOs": {
      "macos": "14.0",
      "windows": "10"
    },
    "isolation": "shared-process",
    "isolationNote": "插件各有独立 WebView 与独立 origin（macOS/Linux），但不承诺独立 renderer 进程；这是架构边界而非安全沙箱。"
  },
