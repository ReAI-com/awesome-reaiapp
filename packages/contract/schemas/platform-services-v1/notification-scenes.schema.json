{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Integrated candidate Host/CLI parser accepts this declaration with minHostApi1.25.0; runtime notification methods remain withheld until their reviewed wiring.",
  "type": "array",
  "maxItems": 32,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "key",
      "label",
      "description",
      "trigger",
      "format",
      "defaultLevel",
      "maxLevel"
    ],
    "properties": {
      "key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "trigger": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "format": {
        "const": "text"
      },
      "defaultLevel": {
        "enum": [
          "in_app",
          "system"
        ]
      },
      "maxLevel": {
        "enum": [
          "in_app",
          "system"
        ]
      }
    }
  }
}
