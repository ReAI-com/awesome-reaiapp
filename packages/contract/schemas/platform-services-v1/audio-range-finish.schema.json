{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Frozen AudioClipsClient request structure only. Host must validate owner, approved time window, epoch/gap, budget and TTL; this schema grants no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "rangeId",
    "endMs"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "rangeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "endMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
