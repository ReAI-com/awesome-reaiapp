{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Frozen declaration-only schema; NOT accepted by app-manifest-1.1 until Host/CLI integration. resource-cloud-project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "provider",
    "projectId",
    "resourceId"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "provider": {
      "const": "cloud-project"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7E]+$"
    },
    "resourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7E]+$"
    }
  }
}
