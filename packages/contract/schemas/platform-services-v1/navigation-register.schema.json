{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Frozen declaration-only schema; NOT accepted by app-manifest-1.1 until Host/CLI integration. navigation-register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "runtimeSessionId",
    "surfaceMountId",
    "presentationToken",
    "revision",
    "breadcrumbs"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]*$"
    },
    "runtimeSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7E]+$"
    },
    "surfaceMountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7E]+$"
    },
    "presentationToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7E]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "breadcrumbs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "command": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commandId"
            ],
            "properties": {
              "commandId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[\\x21-\\x7E]+$"
              },
              "input": {}
            }
          }
        }
      }
    },
    "back": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId"
      ],
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x21-\\x7E]+$"
        },
        "input": {}
      }
    },
    "menu": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "command"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "command": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commandId"
            ],
            "properties": {
              "commandId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[\\x21-\\x7E]+$"
              },
              "input": {}
            }
          },
          "disabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
