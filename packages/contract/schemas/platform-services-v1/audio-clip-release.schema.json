{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Frozen AudioClipsClient request structure only. Host must validate owner, approved time window, epoch/gap, budget and TTL; this schema grants no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "clipId"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "clipId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  }
}
