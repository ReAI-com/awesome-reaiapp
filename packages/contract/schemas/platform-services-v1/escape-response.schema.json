{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Frozen declaration-only schema; NOT accepted by app-manifest-1.1 until Host/CLI integration. escape-response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "runtimeSessionId",
    "surfaceMountId",
    "presentationToken",
    "disposition"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]*$"
    },
    "runtimeSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7E]+$"
    },
    "surfaceMountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7E]+$"
    },
    "presentationToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7E]+$"
    },
    "disposition": {
      "enum": [
        "consumed",
        "pass",
        "input-owned"
      ]
    }
  }
}
