{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reai.com/schemas/app-manifest-1.1.schema.json",
  "title": "ReAI App Manifest v1.1",
  "$comment": "结构契约的单一事实源。App CLI 直接用它校验，Host 的 Rust 结构体由 tests/schema_parity.rs 与它对齐。故意不使用 $ref：内联之后 App 开发者可以顺着读下来，校验器也不必实现引用解析。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "appId",
    "version",
    "publisherId",
    "name",
    "targets",
    "hostApi",
    "requires",
    "runtime",
    "contributes"
  ],
  "properties": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locales",
        "messages"
      ],
      "properties": {
        "locales": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          }
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "key"
            ],
            "properties": {
              "target": {
                "type": "string",
                "enum": [
                  "name",
                  "description",
                  "sidebar.label",
                  "surface.title",
                  "command.title",
                  "command.bindingPickerTitle",
                  "titlebarAction.label",
                  "titlebarAction.text",
                  "titlebarStatus.label",
                  "scheduledTask.title",
                  "scheduledTask.description",
                  "storeListing.category",
                  "storeListing.tagline",
                  "storeListing.longDescription",
                  "storeListing.capability.label",
                  "storeListing.capability.detail",
                  "storeListing.screenshot.caption",
                  "storeListing.phaseOneCommitment",
                  "permission.purpose",
                  "requirement.displayName"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "v2 listing array position, zero-based; cannot be combined with id"
              },
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$"
              }
            }
          }
        }
      }
    },
    "manifestVersion": {
      "type": "string",
      "const": "1.1"
    },
    "packageType": {
      "type": "string",
      "enum": ["app", "skin"],
      "description": "安装包类型；缺省为普通 app。skin 使用同一安装事务但不创建 Runtime。"
    },
    "skin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "entry"],
      "properties": {
        "apiVersion": { "type": "string", "const": "1" },
        "entry": { "type": "string", "const": "skin/skin.json" }
      }
    },
    "appId": {
      "type": "string",
      "$comment": "反向域名式唯一标识，安装后不可更改。",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "publisherId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "oauthAppId": {
      "type": "string",
      "minLength": 8,
      "pattern": "^[A-Za-z0-9._-]{8,128}$",
      "description": "可选的 OAuth App client_id。redirect URI、scope 与版本由 Host 按此 ID 从 OAuth 后端读取。"
    },
    "storeListing": {
      "type": "object",
      "additionalProperties": false,
      "description": "商店上架信息：货架展示 + 详情抽屉的数据源。插件自描述，宿主只读。",
      "required": ["category", "longDescription"],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "商店分类（Official / Productivity / Media / Writing / Dev）"
        },
        "tagline": {
          "type": "string",
          "description": "卡片一句话卖点（区别于 manifest.description 的功能说明）"
        },
        "longDescription": {
          "type": "string",
          "minLength": 1,
          "description": "详情抽屉「这是什么」正文"
        },
        "capabilities": {
          "type": "array",
          "description": "「装上后会怎样」能力清单",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "detail"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        },
        "screenshots": {
          "type": "array",
          "description": "截图（首版用 CSS 渐变 stub，不引外部图片资源）",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gradient", "caption"],
            "properties": {
              "gradient": {
                "type": "string",
                "minLength": 1,
                "description": "CSS linear-gradient 字符串，作为截图区背景（离线占位）"
              },
              "caption": { "type": "string", "minLength": 1 },
              "hasVideo": {
                "type": "boolean",
                "description": "是否带演示视频播放按钮"
              }
            }
          }
        },
        "phaseOneCommitments": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "description": "「第一期就有的三件事」承诺清单（设计稿 t10：给大客户的验收标尺，只有 Codex Link 声明）。详情抽屉在「装上后会怎样」之后单独成段渲染；标题写死「三件事」，所以合同固定恰好三条；缺省 = 其他插件不渲染该段。",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "architectures"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "macos",
              "windows",
              "linux"
            ]
          },
          "architectures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "aarch64",
                "x86_64"
              ]
            }
          }
        }
      }
    },
    "hostApi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range"
      ],
      "properties": {
        "range": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hardwareServices": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "appIntents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "appId",
              "intent",
              "version",
              "purpose"
            ],
            "properties": {
              "appId": {
                "type": "string"
              },
              "intent": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "purpose": {
                "type": "string"
              },
              "requiredFor": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "purpose"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "purpose": { "type": "string", "minLength": 1 },
              "requiredFor": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "protocol",
              "required",
              "headless",
              "activation"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string"
              },
              "protocol": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "headless": {
                "type": "boolean"
              },
              "activation": {
                "type": "string"
              },
              "entry": {
                "type": "string"
              },
              "serviceRef": {
                "type": "string"
              },
              "platforms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lifecycle": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "activate",
                  "deactivate"
                ],
                "properties": {
                  "activate": {
                    "type": "string"
                  },
                  "deactivate": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "requirementsVersion": {
      "type": "string",
      "enum": ["1.1", "1.2"]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "displayName", "kind", "componentId", "required", "requiredFor",
          "platforms", "channels", "version", "probe", "provision", "failure", "remediation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
          "kind": { "type": "string", "const": "managed_executable" },
          "componentId": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "requiredFor": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^capability:[a-z0-9][a-z0-9._-]*@[0-9]+$" }
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["macos", "windows"] }
          },
          "channels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["direct", "mac_app_store", "microsoft_store"] }
          },
          "version": {
            "type": "object",
            "additionalProperties": false,
            "required": ["constraint"],
            "properties": {
              "constraint": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          },
          "probe": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id"],
            "properties": {
              "type": { "type": "string", "const": "host_registered" },
              "id": {
                "type": "string",
                "enum": ["codex-app-server-v1", "pi-agent-v1", "dsh-runner-v1", "audio8-helper-v1", "codex-app-server-v2", "pi-agent-v2", "dsh-native-v2"]
              }
            }
          },
          "provision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "resourceId", "installPolicy", "requiresConsent"],
            "properties": {
              "mode": { "type": "string", "const": "host_managed_resource" },
              "resourceId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[a-z0-9]+([.-][a-z0-9][a-z0-9-]*){2,}$"
              },
              "installPolicy": {
                "type": "string",
                "enum": ["required_at_install", "optional_on_demand"]
              },
              "requiresConsent": { "type": "boolean", "const": true }
            }
          },
          "failure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["componentState", "featureState", "hostState"],
            "properties": {
              "componentState": { "type": "string", "enum": ["blocked", "degraded", "satisfied"] },
              "featureState": { "type": "string", "enum": ["blocked", "degraded", "satisfied"] },
              "hostState": { "type": "string", "enum": ["blocked", "degraded", "satisfied"] }
            }
          },
          "remediation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "label", "restartRequired"],
            "properties": {
              "action": { "type": "string", "const": "install_managed_resource" },
              "label": { "type": "string", "minLength": 1, "maxLength": 160 },
              "restartRequired": { "type": "boolean" }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policyVersion": {
          "type": "integer"
        },
        "endpoints": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "componentId", "origins", "pathPrefixes", "methods", "owner",
              "purpose", "dataCategories", "retention", "required", "providerMode", "auth"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
              "componentId": { "type": "string", "minLength": 1 },
              "origins": {
                "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "pathPrefixes": {
                "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
                "items": { "type": "string", "pattern": "^/" }
              },
              "methods": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": { "type": "string", "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] }
              },
              "owner": { "type": "string", "enum": ["reai", "publisher", "third_party", "user_configured"] },
              "purpose": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": { "type": "string", "enum": ["inference", "authentication", "storage", "sync", "assets", "telemetry", "billing", "support"] }
              },
              "dataCategories": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": { "type": "string", "enum": ["none", "account_identifier", "device_identifier", "user_prompt", "model_response", "conversation", "file_content", "file_metadata", "audio_transcript", "diagnostics", "usage_metrics", "payment_reference"] }
              },
              "retention": {
                "type": "object", "additionalProperties": false, "required": ["mode"],
                "properties": {
                  "mode": { "type": "string", "enum": ["none", "session", "fixed", "provider_policy"] },
                  "maxDays": { "type": "integer", "minimum": 0, "maximum": 3650 },
                  "policyUrl": { "type": "string", "minLength": 1 }
                }
              },
              "required": { "type": "boolean" },
              "providerMode": { "type": "string", "enum": ["host_brokered", "user_configurable", "vendor_only"] },
              "userConfiguredOrigins": {
                "type": "object", "additionalProperties": false, "required": ["allowed", "maxOrigins"],
                "properties": {
                  "allowed": { "type": "boolean" },
                  "maxOrigins": { "type": "integer", "minimum": 0, "maximum": 10 }
                }
              },
              "auth": {
                "type": "object", "additionalProperties": false, "required": ["mode"],
                "properties": { "mode": { "type": "string", "enum": ["none", "managed_cookie", "oauth_app"] } }
              }
            }
          }
        }
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privateStores": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "schemaVersion"
            ],
            "properties": {
              "id": {
                "type": "string",
                "$comment": "KV 键的第二段（appId/storeId/key）。不能带点或斜杠，否则两个 App 能拼出同一个键。",
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
              },
              "schemaVersion": {
                "type": "integer"
              }
            }
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "migration": {
          "type": "object"
        }
      }
    },
    "dataCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollbackFloor"
      ],
      "properties": {
        "rollbackFloor": {
          "type": "string"
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "componentId",
              "location"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "componentId": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "componentId", "methods"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "componentId": { "type": "string", "minLength": 1 },
              "implementation": { "type": "string", "enum": ["host:tts.local@1"] },
              "methods": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "inputSchema", "outputSchema", "timeoutMs", "supportsCancellation"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "inputSchema": { "type": "object" },
                    "outputSchema": { "type": "object" },
                    "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
                    "supportsCancellation": { "type": "boolean" }
                  }
                }
              }
            }
          }
        },
        "titlebarActions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "intent"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "icon": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "variant": { "type": "string", "enum": ["default", "outlined", "danger"] },
              "showOnTitlebarHover": { "type": "boolean" },
              "intent": { "type": "object" }
            }
          }
        },
        "titlebarStatus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "tone"],
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 24 },
            "tone": { "type": "string", "enum": ["neutral", "success", "warning", "danger"] }
          }
        },
        "tabItems": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "componentId"
          ],
          "properties": {
            "componentId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "actionItems": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "componentId"
          ],
          "properties": {
            "componentId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "eventSubscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "componentId",
              "events"
            ],
            "properties": {
              "componentId": {
                "type": "string",
                "minLength": 1
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "acceptsActionContext": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "componentId",
              "contextTypes"
            ],
            "properties": {
              "componentId": {
                "type": "string",
                "minLength": 1
              },
              "contextTypes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "agentFeatures": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48
              },
              "description": {
                "type": "string",
                "maxLength": 200
              },
              "runtime": {
                "type": "string",
                "enum": [
                  "pi",
                  "dsh",
                  "codex"
                ]
              },
              "promptTemplate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384,
                "$comment": "maxLength 按 JSON Schema 码元计；Host 与 CLI 的语义校验按 UTF-8 字节收紧到同值（CJK 模板更早触限），两侧同码"
              },
              "promptParams": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 200
                    }
                  }
                }
              },
              "toolBase": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "sidebarItems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "opens"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "type": "string"
              },
              "opens": {
                "type": "string"
              }
            }
          }
        },
        "scheduledTasks": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "commandId",
              "intervalMs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "commandId": {
                "type": "string",
                "minLength": 1
              },
              "intervalMs": {
                "type": "integer",
                "minimum": 60000,
                "maximum": 86400000
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "componentId",
              "title",
              "inputSchema",
              "outputSchema",
              "timeoutMs",
              "supportsCancellation",
              "concurrency",
              "idempotency",
              "callers"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "componentId": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "bindingPickerVisible": {
                "type": "boolean",
                "description": "是否在键位页的插件动作选择器中展示；缺省为 true。隐藏不影响已有绑定或直接调用。"
              },
              "bindingPickerTitle": {
                "type": "string",
                "minLength": 1,
                "description": "键位选择器专用的简短标题；缺省使用 title。"
              },
              "inputSchema": {
                "type": "object"
              },
              "outputSchema": {
                "type": "object"
              },
              "timeoutMs": {
                "type": "integer"
              },
              "supportsCancellation": {
                "type": "boolean"
              },
              "concurrency": {
                "type": "string",
                "enum": [
                  "serial",
                  "parallel"
                ]
              },
              "idempotency": {
                "type": "string",
                "enum": [
                  "idempotent",
                  "not-idempotent"
                ]
              },
              "callers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "host",
                    "user",
                    "app"
                  ]
                }
              }
            }
          }
        },
        "intents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "componentId",
              "inputSchema"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              },
              "componentId": {
                "type": "string",
                "minLength": 1
              },
              "opens": {
                "type": "string"
              },
              "inputSchema": {
                "type": "object"
              }
            }
          }
        },
        "recommendedBindings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "notificationScenes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label",
              "description",
              "trigger",
              "format",
              "defaultLevel",
              "maxLevel"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "trigger": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "format": {
                "const": "text"
              },
              "defaultLevel": {
                "enum": [
                  "in_app",
                  "system"
                ]
              },
              "maxLevel": {
                "enum": [
                  "in_app",
                  "system"
                ]
              }
            }
          }
        }
      }
    }
  }
}
